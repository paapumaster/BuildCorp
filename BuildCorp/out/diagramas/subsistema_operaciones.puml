@startuml
left to right direction
skinparam packageStyle rectangle

actor "Bodeguero" as Bodeguero
actor "Contratista / Responsable" as Contratista
actor "Sistema Central" as Sistema

rectangle "BuildCorp - Subsistema 1: Operaciones de Obra y Préstamos" {
    usecase "Consultar Disponibilidad de Activo" as UC1
    usecase "Registrar Préstamo de Herramienta" as UC2
    usecase "Capturar Firma Digital (Offline/PWA)" as UC3
    usecase "Registrar Devolución y Estado" as UC4
    usecase "Generar Comprobante Digital" as UC5

    Bodeguero --> UC1
    Bodeguero --> UC2
    Bodeguero --> UC4
    
    Contratista --> UC1
    Contratista --> UC3
    
    UC2 ..> UC3 : <<include>>
    UC4 ..> UC5 : <<include>>
    
    UC2 --> Sistema
    UC4 --> Sistema
}
@enduml